# Railway PostgreSQL public/external connection URL
DATABASE_URL=postgresql://user:password@host:port/database

# OpenAI project API key and a model with Responses API Structured Outputs
OPENAI_API_KEY=replace-with-your-project-api-key
OPENAI_MODEL=gpt-5.6

# Optional OpenAI request timeout in milliseconds (defaults to 60000)
OPENAI_TIMEOUT_MS=60000

# Optional chapter/unit-sized Source Text guardrail (defaults to 20000)
SOURCE_TEXT_MAX_CHARACTERS=20000

# Google Cloud Translation Advanced project and one-line service account JSON
GOOGLE_CLOUD_PROJECT_ID=replace-with-your-google-cloud-project-id
GOOGLE_CLOUD_TRANSLATION_CREDENTIALS='{"client_email":"translator@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"}'

# Optional Translation location and request timeout (defaults: global, 10000)
GOOGLE_CLOUD_TRANSLATION_LOCATION=global
GOOGLE_CLOUD_TRANSLATION_TIMEOUT_MS=10000

# Private Railway Bucket (S3-compatible) used for optional Question Images
RAILWAY_BUCKET_ENDPOINT=https://storage.railway.app
RAILWAY_BUCKET_REGION=auto
RAILWAY_BUCKET_NAME=replace-with-your-bucket-name
RAILWAY_BUCKET_ACCESS_KEY_ID=replace-with-your-bucket-access-key
RAILWAY_BUCKET_SECRET_ACCESS_KEY=replace-with-your-bucket-secret-key

# Comma-separated browser origins that must have PUT access in bucket CORS
QUESTION_IMAGE_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
